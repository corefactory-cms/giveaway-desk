{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "응모수첩 개인 신청·당첨 기록",
  "type": "object",
  "required": ["kind", "records"],
  "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["applications", "results"]},
    "records": {"type": "array", "minItems": 1, "maxItems": 3000}
  },
  "if": {"properties": {"kind": {"const": "applications"}}},
  "then": {"properties": {"records": {"items": {"$ref": "#/$defs/application"}}}},
  "else": {"properties": {"records": {"items": {"$ref": "#/$defs/result"}}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"},
    "amount": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "prizeItem": {
      "type": "object",
      "required": ["name", "quantity"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
        "quantity": {"type": "integer", "minimum": 1, "maximum": 999999}
      }
    },
    "application": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"const": "응모"}}
    },
    "result": {
      "type": "object",
      "required": ["id", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["당첨", "미당첨"]},
        "award_cash": {"$ref": "#/$defs/amount"},
        "award_voucher": {"$ref": "#/$defs/amount"},
        "award_items": {
          "type": ["array", "null"], "maxItems": 100,
          "items": {"$ref": "#/$defs/prizeItem"}
        }
      },
      "if": {"properties": {"status": {"const": "미당첨"}}},
      "then": {"properties": {
        "award_cash": {"enum": [0, null]}, "award_voucher": {"enum": [0, null]},
        "award_items": {"enum": [[], null]}
      }}
    }
  }
}
